{
  "name": "tomo-ai",
  "version": "0.9.0",
  "description": "Personal assistant powered by Claude Agent SDK",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tomo": "dist/cli.js"
  },
  "files": [
    "dist",
    "defaults",
    "contrib",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "dev": "tsx watch src/cli.ts -- start",
    "start": "node dist/cli.js start",
    "tomo": "tsx src/cli.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/ web/",
    "prepublishOnly": "npm run build",
    "postinstall": "echo '\n  Welcome to Tomo! 🤖\n\n  First time?  tomo init\n  Start:       tomo start\n  Upgraded?    tomo restart\n  Help:        tomo --help\n'",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "test:web:mutations": "node scripts/test-web-mutations.mjs"
  },
  "keywords": [
    "ai",
    "assistant",
    "claude",
    "telegram",
    "chatbot",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shuaiyuan17/tomo.git"
  },
  "homepage": "https://github.com/shuaiyuan17/tomo#readme",
  "bugs": {
    "url": "https://github.com/shuaiyuan17/tomo/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@clack/prompts": "^1.4.0",
    "commander": "^15.0.0",
    "croner": "^10.0.1",
    "grammy": "^1.35.0",
    "ink": "^7.1.0",
    "minimatch": "^10.2.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "react": "^19.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "dotenv": "^17.4.1",
    "eslint": "^10.6.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "8.3.0",
    "vitest": "^5.0.1"
  }
}
